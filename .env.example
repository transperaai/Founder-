# Postgres (Neon in production, pooled). Local: postgresql://postgres:postgres@localhost:5432/founder
DATABASE_URL=
# Direct connection used by migrations. Locally, the same as DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Auth.js session secret: `openssl rand -base64 32`
AUTH_SECRET=
# 32-byte base64 key for secrets at rest: `openssl rand -base64 32`
ENCRYPTION_KEY=
# Google sign-in (with calendar.readonly)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Microsoft sign-in (with Calendars.Read). Issuer e.g. https://login.microsoftonline.com/common/v2.0
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# Claude API key for AI steps
ANTHROPIC_API_KEY=
# Inngest Cloud keys (set by the Vercel integration). Leave empty locally: analysis then runs in-process.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set to 1 to use a local Inngest dev server instead (npx inngest-cli@latest dev)
INNGEST_DEV=
# Vercel Blob (set by the Blob integration)
BLOB_READ_WRITE_TOKEN=
# Comma-separated emails allowed to sign in besides the first user
FOUNDER_EMAILS=
# "true" adds a password-less demo sign-in and seeds demo data on Vercel builds. Never with real client data.
DEMO_MODE=
